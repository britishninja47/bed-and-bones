<div class="navbar navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <i class="fas fa-home" aria-hidden="true" style="font-size:1.25rem;"></i>
      <span class="ms-2">Home</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="search-form-control form-group">
      <%= form_tag pets_path, method: :get do %>
        <%= text_field_tag :query,
          params[:query],
          class: "form-control string required",
          placeholder: "Find a pet"
          %>
          <button name="button" type="submit" class="btn btn-flat">
          <i class="fas fa-search"></i> Search
          </button>
      <% end %>
    </div>


    <div class="collapse navbar-collapse" id="navbarSupportedContent">

<ul class="navbar-nav">
  <li class="nav-item">
    <%= link_to "Browse Pets", pets_path, class:"nav-link"%>
  </li>
  <li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" id="speciesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
      Species
    </a>
    <ul class="dropdown-menu" aria-labelledby="speciesDropdown">
      <%= link_to "All", pets_path, class: "dropdown-item" %>
      <% Species.order(:name).each do |s| %>
        <%= link_to s.name, pets_path(species_id: s.id), class: "dropdown-item" %>
      <% end %>
    </ul>
  </li>
</ul>
<ul class="navbar-nav ms-auto">


        <% if user_signed_in? %>
          <li class="nav-item dropdown">

            <ul class="dropdown-menu" aria-labelledby="speciesDropdown">
              <%= link_to "All", pets_path, class: "dropdown-item" %>
              <% Species.order(:name).each do |s| %>
                <%= link_to s.name, pets_path(species_id: s.id), class: "dropdown-item" %>
              <% end %>
            </ul>
          </li>

          <li class="nav-item dropdown">


            <a class="nav-link dropdown-toggle avatar show" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="true" style="font-size: 1.5rem; color: #4ecdc4;margin-left: -54px;">
              <i class="fas fa-paw" style="padding-left: 0px;border-left-width: 0px;border-left-style: solid;margin-left: -64px;"></i>
            </a>

            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <a class="dropdown-item" href="/my_bookings">My bookings</a>
              <a class="dropdown-item" href="/my_pets">My pets</a>
              <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "dropdown-item", data: { turbo: false }, style: "border: none; background: none; text-align: left; width: 100%;" %>
            </ul>

          </li>
        <% else %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="guestDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Account
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="guestDropdown">
              <%= link_to "Log in", new_user_session_path, class: "dropdown-item" %>
              <%= link_to "Sign up", new_user_registration_path, class: "dropdown-item" %>
            </ul>
          </li>

        <% end %>


      </ul>
    </div>
  </div>
</div>
