<div class="centered col-6 m-auto">
  <h1 class="center-text">Edit This Pet</h1>
  <%= simple_form_for @pet, html: { multipart: true } do |f| %>
    <%= f.input :name, label: 'Pet name' %>
    <%= f.input :age, label: 'Pet age' %>
    <%= f.input :address, label: 'Your address' %>
    <%= f.input :price, label: 'Price per day' %>
    <%= f.association :species, label: 'Species' %>
    <% if @pet.photo.attached? %>
      <div class="mb-3">
        <p>Current photo:</p>
        <%= image_tag url_for(@pet.photo), class: 'img-fluid rounded', style: 'max-height: 220px; object-fit: cover;' %>
      </div>
    <% end %>
    <%= f.input :photo, as: :file, label: 'Upload a new photo' %>
    <%= f.button :submit, class: "custom-btn blue" %>
    <%= link_to 'Cancel', my_pets_path, class: "custom-btn orange" %>
  <% end %>
</div>
