<br><br>
  <div class="card col-7 col-md-5 col-lg-3 center-card m-auto">
    <% if @pet.photo.attached? %>
      <%= image_tag url_for(@pet.photo), class: "card-img-top", height: 300, width: 400 %>
    <% else %>
      <% species = @pet.species.name.downcase
        image_url = case species
        when 'dog'
          "https://placedog.net/400/300?id=#{@pet.id}"
        when 'cat'
          "https://cataas.com/cat?type=original&size=small"
        else
          "https://picsum.photos/400/300?random=#{@pet.id}"
        end %>
      <%= image_tag image_url, class: "card-img-top" %>
    <% end %>
    <div class="card-body">
      <h2 class="card-title"><%=@pet.name.capitalize%></h2>
      <p class="card-subtitle mb-2 text-muted"><%= @pet.species.name.capitalize %></p>
      <% if (@pet.age < 2)  %>
        <p class="card-text"><%= @pet.age %> year old</p>
      <% else %>
        <p class="card-text"><%= @pet.age %> years old</p>
      <% end %>
    </div>
    <div class="card-body price">
      <p>£<%= @pet.price %> / day</p>
    </div>
    <div class="card-body book-now">
      <%= link_to 'Book Now', new_pet_booking_path(@pet), class: "custom-btn blue "%>
      <%= link_to 'Back', pets_path, class: "custom-btn orange" %>
    </div>
  </div>

<%# Review Area %>
