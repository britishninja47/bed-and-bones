<div class="center center-text">
  <h1>Booking Confirmed:</h1>
  <br>

  <div class="card col-6 center-card m-auto">
     <%= link_to @booking.pet, class: "link" do %>
         <% if @booking.pet.photo.attached? %>
          <%= image_tag url_for(@booking.pet.photo), class: "card-img-top", height: 300, width: 400 %>
        <% else %>
          <% species = @booking.pet.species.name.downcase
            image_url = case species
            when 'dog'
              "https://placedog.net/400/300?id=#{@booking.pet.id}"
            when 'cat'
              "https://cataas.com/cat?type=original&size=small"
            else
              "https://picsum.photos/400/300?random=#{@booking.pet.id}"
            end %>
          <%= image_tag image_url, class: "card-img-top" %>
        <% end %>
    <div class="card-body">
      <h5 class="card-title"><%= @booking.pet.name %></h5>
      <h6 class="card-subtitle mb-2 text-muted"><%= @booking.pet.species.name.capitalize %></h6>
      <p class="card-text">From: <%= @booking.start_date %></p>
      <p class="card-text">To: <%= @booking.end_date %></p>
    </div>
    <div class="card-body price">
      <h6>£<%= @booking.pet.price %> / day</h6>
    </div>
    <% end %>
  </div>
  <br>
  <%= link_to 'View My Bookings', my_bookings_path, class: "custom-btn blue" %>
</div>
