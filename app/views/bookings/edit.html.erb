<div class="container mt-5">
  <h1>Edit Booking</h1>
  <%= simple_form_for [@booking.pet, @booking] do |f| %>
    <%= f.input :start_date, as: :date, html5: true %>
    <%= f.input :end_date, as: :date, html5: true %>
    <p>Total: £<%= (@booking.end_date - @booking.start_date).to_i * @booking.pet.price %> </p>
    <%= f.submit 'Update Booking', class: "btn btn-primary" %>
    <%= link_to 'Back', booking_path(@booking), class: "btn btn-secondary" %>
  <% end %>
</div>
