<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center">
    <h1>Animals</h1>
    <%= link_to 'Browse All Pets', pets_path, class: 'btn btn-outline-primary' %>
  </div>

  <p class="mt-2">Explore animals available for short-term stays. Use the "Species" menu in the navbar to filter by type, or click a species card below to view matching pets.</p>

  <div class="row mt-3">
    <% Species.order(:name).each do |s| %>
      <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= s.name %></h5>
            <p class="card-text mb-4"><%= pluralize(Pet.where(species: s).count, 'pet') %> available</p>
            <div class="mt-auto">
              <%= link_to 'View listings', pets_path(species_id: s.id), class: 'btn btn-primary btn-block' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
