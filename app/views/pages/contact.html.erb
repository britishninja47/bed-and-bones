<div class="container mt-4">
  <h1>Contact Us</h1>
  <p>If you have questions about listing, booking, or how Bed & Bones works, reach out to our team. Typical response time: 1-2 business days.</p>

  <div class="row">
    <div class="col-md-6">
      <h4>Contact Details</h4>
      <ul class="list-unstyled">
        <li><strong>Email:</strong> support@bedandbones.example</li>
        <li><strong>Phone:</strong> +44 20 7946 0000</li>
        <li><strong>Address:</strong> 123 Pet Lane, London, UK</li>
      </ul>

      <h5>Support Hours</h5>
      <p>Mon–Fri, 9:00–17:00 (GMT)</p>
    </div>

    <div class="col-md-6">
      <h4>Send Us a Message</h4>
      <%= form_with url: contact_path, method: :post, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :name %>
          <%= f.text_field :name, class: "form-control", required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :email %>
          <%= f.email_field :email, class: "form-control", required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :message %>
          <%= f.text_area :message, class: "form-control", rows: 5, required: true %>
        </div>
        <%= f.submit "Send Message", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
