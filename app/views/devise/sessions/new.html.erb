<div class="login-container">
  <div class="login-card">
    <h2><i class="fas fa-paw me-2" style="color: #ff9a56;"></i>Log in to Bed & Bones</h2>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { novalidate: true, data: { controller: 'form' } }) do |f| %>
      <%= f.error_notification class: 'alert alert-danger mt-2 rounded-pill py-2' %>

      <div class="form-inputs">
        <div class="form-input-group">
          <i class="fas fa-envelope input-icon"></i>
          <%= f.input :email,
                      label: false,
                      required: false,
                      autofocus: true,
                      input_html: { autocomplete: "email", class: 'form-control ps-5', placeholder: 'Enter your email' } %>
        </div>

        <div class="form-input-group">
          <i class="fas fa-lock input-icon"></i>
          <%= f.input :password,
                      label: false,
                      required: false,
                      input_html: { autocomplete: "current-password", class: 'form-control ps-5 pe-5', placeholder: 'Enter your password', id: 'user_password' } %>
          <button type="button" class="password-toggle" onclick="togglePassword()" data-action="click->form#togglePassword">
            <i class="fas fa-eye" id="toggleIcon"></i>
          </button>
        </div>

        <div class="form-input-group remember-me">
          <%= f.input :remember_me,
                      label: 'Remember me?',
                      as: :boolean,
                      input_html: { class: 'form-check-input me-3' } %>
        </div>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in 🐾", class: "btn btn-login mb-4 w-100" %>
      </div>
    <% end %>

    <div class="links text-center">
      <%= render "devise/shared/links" %>
      <hr class="my-3 opacity-25">
      <small class="text-white-50">New here? <%= link_to "Sign up", new_user_registration_path %></small>
    </div>
  </div>
</div>
